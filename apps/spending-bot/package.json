{
  "name": "spending-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply spending-bot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply spending-bot-db --remote",
    "setup:telegram": "node scripts/setup-telegram.mjs",
    "types": "wrangler types --strict-vars=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true,
    "fsevents@2.3.3": false
  }
}
