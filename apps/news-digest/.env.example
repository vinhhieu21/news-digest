GEMINI_API_KEY=your_key_from_aistudio_google_com
TELEGRAM_BOT_TOKEN=123456:ABCDEF_from_BotFather
# Your own chat id for local runs. CI posts to the group (see digest.yml).
TELEGRAM_CHAT_ID=123456789

# Leave empty to use defaults (see src/config.py).
# Override format: comma-separated, optional `url|cap` per entry, where cap is the
# number of recent candidates pulled from that feed (default cap=6).
# Example: RSS_URLS_VN=https://a.rss|3,https://b.rss|1
RSS_URLS_VN=
RSS_URLS_ENG=

TOP_N=7
# Comma-separated, tried in order. Leave empty to use the default list in src/config.py.
GEMINI_MODELS=
LOOKBACK_HOURS=24
